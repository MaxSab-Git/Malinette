Test subjects 00: subjects/ex00
	:randalphanum(32) program_name:
	:append program_name ".exe":

	clang -Wall -Wextra -Werror test.c -o :get program_name:

	:timeout(1000):
	:loop(10):
	:randint(-12, 10) c:

	:launch(echo) c:
	:compare:
	.:concat "./" program_name: :get c:

	:end:

	:launch(remove) program_name:

Test subjects 01: subjects/ex01
	:randalphanum(32) program_name:
