{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "malinette",
	"patterns": [
		{
			"include": "#testContext"
		},
		{
			"include": "#testCommand"
		},
		{
			"include": "#testOperation"
		},
		{
			"include": "#testVariableCommand"
		}
	],
	"repository": {
		"testContext": {
			"patterns": [
				{
					"match": "^([\\x20-\\x7E]+)\\ *:\\ *([\\x20-\\x7E]+)\\n",
					"captures": {
						"1": {
							"name": "entity.name.function.malinette"
						},
						"2": {
							"name": "variable.other.malinette"
						}
					}
				}
			]
		},
		"stringsArg": {
			"begin": "\"",
			"end": "\"",
			"name": "string.quoted.double.malinette"
		},
		"parameter": {
			"begin": "\\(",
			"end": "\\)",
			"patterns": [
				{
					"match": "[0-9]+",
					"name": "constant.numeric.malinette"
				}
			],
			"name": "meta.parameter.malinette"
		},
		"testOperation": {
			"begin": ":(?:(loop|end)|([a-zA-Z]+))",
			"end": ":",
			"name": "meta.control.malinette",
			"beginCaptures": {
				"1": {
					"name": "keyword.control.malinette"
				},
				"2": {
					"name": "entity.name.function.malinette"
				}
			},
			"patterns": [
				{
					"include": "#stringsArg"
				},
				{
					"include": "#parameter"
				},
				{
					"match": "[a-zA-Z_]+",
					"name": "string.interpolated.malinette"
				}
			]
		},
		"testCommand": {
			"begin": "^\\t([a-zA-Z0-9_\\/\\.\\-\\(\\)\\\\]+?|\"[ a-zA-Z0-9_\\/\\.\\-\\(\\)\\\\]+?\")\\s",
			"end": "\\n",
			"name": "meta.command.malinette",
			"beginCaptures": {
				"1": {
					"name": "entity.name.tag.malinette"
				}
			},
			"patterns": [
				{
					"match": "([^\\x00-\\x20:]+?)",
					"captures": {
						"1": {
							"name": "string.unquoted.malinette"
						}
					}
				},
				{
					"include": "#testOperation"
				}
			]
		},
		"testVariableCommand": {
			"begin": "^\\t(\\.)",
			"end": "\\n",
			"beginCaptures": {
				"1": {
					"name": "entity.name.tag.malinette"
				}
			},
			"patterns": [
				{
					"include": "#testOperation"
				},
				{
					"match": "([^\\x00-\\x20:]+?)",
					"captures": {
						"1": {
							"name": "variable.parameter.malinette"
						}
					}
				}
			]
		},
		"testControlCommand": {
			"begin": "^\\t(\\.:)(?:(loop|end)|([a-zA-Z]+))",
			"end": ":",
			"name": "meta.command.variable.malinette",
			"beginCaptures": {
				"2": {
					"name": "keyword.control.malinette"
				},
				"3": {
					"name": "entity.name.function.malinette"
				},
				"1": {
					"name": "entity.name.tag.malinette"
				}
			},
			"endCaptures": {
				"0": {
					"name": "entity.name.tag.malinette"
				}
			},
			"patterns": [
				{
					"include": "#stringsArg"
				},
				{
					"include": "#parameter"
				},
				{
					"match": "[a-zA-Z_]+",
					"name": "string.interpolated.malinette"
				}
			]
		}
	},
	"scopeName": "source.malinette"
}