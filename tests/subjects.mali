Test subjects 00: subjects/ex00
	:randalphanum(32) program_name:
	/bin/mkdir -p user
	/bin/cc -Wall -Wextra -Werror test.c -o :concat "user/" program_name:

	:loop(10):
	:randprint c:
	/bin/echo :get c:
	:compare:
	.:concat "./user/" program_name: :get c:
	:end:

Test subjects 01: subjects/ex01
