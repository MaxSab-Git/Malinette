Compile lightcmd: .
	../bin/Malinette "testfiles/lightcmd/compile_light_cmd.mali"

Test subjects 00: subjects/ex00
	:randalphanum(32) program_name:
	clang -Wall -Wextra -Werror test.c -o :concat program_name ".exe":

	:loop(10):
	:randprint c:
	.:concat malidir "testfiles/lightcmd/echo.exe": :get c:
	:compare:
	.:concat "./" program_name ".exe": :get c:
	:end:
	.:concat malidir "testfiles/lightcmd/rm.exe": :concat program_name ".exe":

Test subjects 01: subjects/ex01
	:randalphanum(32) program_name:
	clang -Wall -Wextra -Werror put_char.c :malifile "testfiles/ex00main.c": -o :concat program_name ".exe":

	:loop(10):
	:randprint(16) str:
	.:concat malidir "testfiles/lightcmd/echo.exe": :get str:
	:compare:
	.:concat "./" program_name ".exe": :get str:
	:end:
	.:concat malidir "testfiles/lightcmd/rm.exe": :concat program_name ".exe":
